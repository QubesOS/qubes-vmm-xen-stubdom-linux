From cfe6757c67d5979ab3472dbb70924288b59c1bee Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Fr=C3=A9d=C3=A9ric=20Pierret=20=28fepitre=29?=
 <frederic.pierret@qubes-os.org>
Date: Mon, 1 Nov 2021 18:17:55 +0100
Subject: [PATCH 04/21] QubesGUI display options

Adapted from https://github.com/QubesOS/qubes-gui-agent-xen-hvm-stubdom/blob/29c0b1bb9a1b32a69b040bb83767f461eb7bd418/gui-agent-qemu/qemu-glue.patch

Author: marmarek

Contributors: HW42, fepitre
---
 hw/display/vga.c     |  2 ++
 include/ui/console.h |  6 ++++++
 meson.build          |  8 ++++++++
 qapi/ui.json         | 21 +++++++++++++++++++--
 ui/console.c         |  5 +++++
 ui/meson.build       |  2 ++
 6 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/hw/display/vga.c b/hw/display/vga.c
index 37557c3442..3206bcb0ff 100644
--- a/hw/display/vga.c
+++ b/hw/display/vga.c
@@ -1618,6 +1618,8 @@ static void vga_draw_graphic(VGACommonState *s, int full_update)
     } else {
         allocate_surface = true;
     }
+    /* XXX: Qubes GUI can't use a shared buffer */
+    allocate_surface = true;
 
     if (s->params.line_offset != s->last_line_offset ||
         disp_width != s->last_width ||
diff --git a/include/ui/surface.h b/include/ui/surface.h
index 3e8b22d6c6..f3f0dfa5c3 100644
--- a/include/ui/surface.h
+++ b/include/ui/surface.h
@@ -27,6 +27,7 @@ typedef struct DisplaySurface {
 #endif
     qemu_pixman_shareable share_handle;
     uint32_t share_handle_offset;
+    uint32_t *xen_refs;
 } DisplaySurface;
 
 PixelFormat qemu_default_pixelformat(int bpp);
diff --git a/include/ui/console.h b/include/ui/console.h
index 3e8b22d6c6..f3f0dfa5c3 100644
--- a/include/ui/console.h
+++ b/include/ui/console.h
@@ -313,6 +313,11 @@ static inline pixman_format_code_t surface_format(DisplaySurface *s)
 
 bool qemu_console_has_gl(QemuConsole *con);
 
+static inline uint32_t *surface_xen_refs(DisplaySurface *s)
+{
+    return s->xen_refs;
+}
+
 enum {
     GRAPHIC_FLAGS_NONE     = 0,
 /* require a console/display with GL callbacks */
diff --git a/meson.build b/meson.build
index d6281c4f01..708a7f942b 100644
--- a/meson.build
+++ b/meson.build
@@ -1891,6 +1891,13 @@ if not get_option('libdw').auto() or \
                        required: get_option('libdw'))
 endif
 
+vchan_xen = dependency('vchan-xen', required: true, method: 'pkg-config')
+
+add_project_arguments(
+  '-iquote', meson.current_source_dir() / 'ui' / 'gui-agent' / 'include',
+  language: ['c', 'cpp', 'objc']
+)
+
 #################
 # config-host.h #
 #################
@@ -4288,6 +4295,7 @@ summary_info += {'fdt support':       fdt_opt == 'disabled' ? false : fdt_opt}
 summary_info += {'libcap-ng support': libcap_ng}
 summary_info += {'bpf support':       libbpf}
 summary_info += {'rbd support':       rbd}
+summary_info += {'libvchan support':  vchan_xen}
 summary_info += {'smartcard support': cacard}
 summary_info += {'U2F support':       u2f}
 summary_info += {'libusb':            libusb}
diff --git a/qapi/ui.json b/qapi/ui.json
index 006616aa77..0950bc05d4 100644
--- a/qapi/ui.json
+++ b/qapi/ui.json
@@ -1441,6 +1441,21 @@
 { 'struct'  : 'DisplaySDL',
   'data'    : { '*grab-mod'   : 'HotKeyMod' } }
 
+##
+# @DisplayQubesGUI:
+#
+# QubesGUI display options.
+#
+# @log-level: Log level
+# @domid: Domain ID of backend (gui-daemon)
+#
+# Since: 3.0
+#
+##
+{ 'struct'  : 'DisplayQubesGUI',
+  'data'    : { '*log-level': 'int',
+                'domid'     : 'int' } }
+
 ##
 # @DisplayType:
 #
@@ -1520,6 +1520,8 @@
 #
 # @dbus: Start a D-Bus service for the display.  (Since 7.0)
 #
+# @qubes-gui: Qubes GUI
+#
 # Since: 2.12
 ##
 { 'enum'    : 'DisplayType',
@@ -1488,7 +1503,8 @@
     { 'name': 'curses', 'if': 'CONFIG_CURSES' },
     { 'name': 'cocoa', 'if': 'CONFIG_COCOA' },
     { 'name': 'spice-app', 'if': 'CONFIG_SPICE' },
-    { 'name': 'dbus', 'if': 'CONFIG_DBUS_DISPLAY' }
+    { 'name': 'dbus', 'if': 'CONFIG_DBUS_DISPLAY' },
+    { 'name': 'qubes-gui'}
   ]
 }
 
@@ -1526,7 +1542,8 @@
       'egl-headless': { 'type': 'DisplayEGLHeadless',
                         'if': 'CONFIG_OPENGL' },
       'dbus': { 'type': 'DisplayDBus', 'if': 'CONFIG_DBUS_DISPLAY' },
-      'sdl': { 'type': 'DisplaySDL', 'if': 'CONFIG_SDL' }
+      'sdl': { 'type': 'DisplaySDL', 'if': 'CONFIG_SDL' },
+      'qubes-gui': { 'type': 'DisplayQubesGUI' }
   }
 }
 
diff --git a/ui/display-surface.c.orig b/ui/display-surface.c
index 38e4085..ffbf346 100644
--- a/ui/display-surface.c.orig
+++ b/ui/display-surface.c
@@ -7,6 +7,7 @@
  */
 #include "qemu/osdep.h"
 #include "ui/console.h"
+#include "qubes-gui-qemu.h"
 #include "ui/vgafont.h"
 #include "trace.h"
 
@@ -47,14 +47,14 @@
                                                   width, height,
                                                   (void *)data, linesize);
     } else {
-        qemu_pixman_image_new_shareable(&surface->image,
-                                        &surface->share_handle,
-                                        "displaysurface",
-                                        format,
-                                        width,
-                                        height,
-                                        linesize,
-                                        &error_abort);
+        data = qubesgui_alloc_surface_data(width, height, &surface->xen_refs);
+        assert(data != NULL);
+        surface->image = pixman_image_create_bits(format,
+                                                  width, height,
+                                                  (void *)data, linesize);
+        pixman_image_set_destroy_function(surface->image,
+                                          qubesgui_free_image_data,
+                                          NULL);
         surface->flags = QEMU_ALLOCATED_FLAG;
     }
 
diff --git a/ui/meson.build.orig b/ui/meson.build
index d345f6c..fa0e6c6 100644
--- a/ui/meson.build.orig
+++ b/ui/meson.build
@@ -189,6 +189,8 @@ if spice.found()
   endif
 endif
 
+subdir('gui-agent')
+
 subdir('shader')
 
 if have_system
-- 
2.41.0

