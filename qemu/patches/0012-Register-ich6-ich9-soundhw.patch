 <frederic.pierret@qubes-os.org>
Date: Mon, 1 Nov 2021 18:40:04 +0100
Subject: [PATCH 12/21] Register ich6 ich9 soundhw

Adapted from https://github.com/QubesOS/qubes-vmm-xen-stubdom-linux/blob/2a814bd1edaf549ef9252eb6747aa6137abf9831/qemu/patches/qemu-register-ich6-ich9-soundhw.patch

Author: easydozen

Contributors: fepitre
---
 hw/audio/intel-hda.c | 15 +++++++++++++++
 hw/audio/soundhw.c   |  2 +-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/hw/audio/intel-hda.c b/hw/audio/intel-hda.c
index b9ed231fe8..d6277916dc 100644
--- a/hw/audio/intel-hda.c
+++ b/hw/audio/intel-hda.c
@@ -1321,6 +1321,22 @@ static int intel_hda_and_codec_init(PCIBus *bus, const char *audiodev)
     object_unref(intel_hda);
 }
 
+static void intel_ich9_and_codec_init(const char *audiodev)
+{
+    g_autoptr(QDict) props = qdict_new();
+    DeviceState *intel_hda, *codec;
+    BusState *hdabus;
+    
+    qdict_put_str(props, "driver", "ich9-intel-hda");
+    intel_hda = qdev_device_add_from_qdict(props, false, &error_fatal);
+    hdabus = QLIST_FIRST(&intel_hda->child_bus);
+
+    codec = qdev_new("hda-duplex");
+    qdev_prop_set_string(codec, "audiodev", audiodev);
+    qdev_realize_and_unref(codec, hdabus, &error_fatal);
+    object_unref(intel_hda);
+}
+
 static void intel_hda_register_types(void)
 {
     type_register_static(&hda_codec_bus_info);
@@ -1329,6 +1342,8 @@ static void intel_hda_register_types(void)
     type_register_static(&intel_hda_info_ich9);
     type_register_static(&hda_codec_device_type_info);
     audio_register_model_with_cb("hda", "Intel HD Audio", intel_hda_and_codec_init);
+    audio_register_model_with_cb("ich6", "ich6 Intel HD Audio", intel_hda_and_codec_init);
+    audio_register_model_with_cb("ich9", "ich9 Intel HD Audio", intel_ich9_and_codec_init);
 }
 
 type_init(intel_hda_register_types)
diff --git a/hw/audio/soundhw.c b/hw/audio/soundhw.c
index 94d9463e42..1a939f2bb6 100644
--- a/hw/audio/model.c
+++ b/hw/audio/model.c
@@ -40,7 +40,7 @@ struct soundhw {
     void (*init)(const char *audiodev);
 };
 
-static struct audio_model audio_models[9];
+static struct audio_model audio_models[11];
 static int audio_models_count;
 
 void audio_register_model_with_cb(const char *name, const char *descr,
-- 
